# RunPod / application
APP_HOST=0.0.0.0
APP_PORT=8001
WORKSPACE_ROOT=/workspace
MODEL_DIR=/workspace/models/checkpoints
DATA_ROOT=/data
LOCAL_DATA_ROOT=/data/dataset
LOCAL_OUTPUT_ROOT=/data/output
LOCAL_JOB_ROOT=/data/jobs
LOCAL_CONFIG_ROOT=/data/config
CACHE_DIR=/data/cache
HF_HOME=/data/cache/huggingface
HUGGINGFACE_HUB_CACHE=/data/cache/huggingface/hub

# Optional aliases; start.sh derives these from the LOCAL_* values above.
# DATASET_DIR=/data/dataset
# OUTPUT_DIR=/data/output
# LOG_DIR=/data/jobs
# CONFIG_DIR=/data/config

# RunPod bootstrap settings
# REPO_URL=https://github.com/nayu-822/SDXL-LoRA-Factory.git
# GIT_BRANCH=feature/runpod-base
# APP_DIR=/app/SDXL-LoRA-Factory

# rclone (do not commit rclone.conf or tokens)
RCLONE_CONFIG=/data/rclone/rclone.conf
GDRIVE_REMOTE=gdrive
RCLONE_BIN=rclone
GDRIVE_ROOT=SDXL-LoRA-Factory/runs
GDRIVE_ENABLED=true

# Optional RunPod Secret inputs. Existing RCLONE_CONFIG takes precedence.
# RCLONE_CONFIG_CONTENT=
# RCLONE_CONFIG_B64=
# GDRIVE_TOKEN=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_SERVICE_ACCOUNT_JSON=

# Optional overrides
# SD_SCRIPTS_ROOT=/app/SDXL-LoRA-Factory/backend/sd-scripts
# Windows legacy external dataset compatibility switch (Linux/RunPod uses DATASET_DIR)
# ALLOW_EXTERNAL_DATASET_PATHS=false
# WD14_ALLOW_MOCK=false
# RunPod bootstrap installs requirements-runpod.txt and keeps this at 0.
# AUTO_SETUP=1
