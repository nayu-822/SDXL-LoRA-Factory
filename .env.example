# RunPod / application
APP_HOST=0.0.0.0
APP_PORT=8001
WORKSPACE_ROOT=/workspace
LOCAL_DATA_ROOT=/workspace/data
LOCAL_OUTPUT_ROOT=/workspace/output
LOCAL_JOB_ROOT=/workspace/jobs
LOCAL_CONFIG_ROOT=/workspace/config

# rclone (do not commit rclone.conf or tokens)
RCLONE_CONFIG=/workspace/rclone/rclone.conf
GDRIVE_REMOTE=gdrive
RCLONE_BIN=rclone

# Optional overrides
# SD_SCRIPTS_ROOT=/workspace/SDXL-LoRA-Factory/backend/sd-scripts
# ALLOW_EXTERNAL_DATASET_PATHS=false
# WD14_ALLOW_MOCK=false
# AUTO_SETUP=1
